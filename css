/* ========================================
🌸 ПЛЕЕР В ПОСТАХ
======================================== */

.podcast-player {
    border: 1px solid #383838;
    border-radius: 10px;
    max-width: 400px;
    width: 95%;
    padding: .5em;
    background: #fffffd;
    background-image: url(https://i1.beon.fun/27/80/8027/16/1936916/fon.png);
    background-size: auto;
}

.podcast-player__title > * {
    vertical-align: middle;
}

.podcast-player__title img {
    display: none !important;
}

.podcast-player__title a {
    color: #383838;
    text-decoration: none !important;
    font-weight: bold;
    font-size: 14px;
    transition: 0.3s;
    padding-left: 5px;
}

.podcast-player__title a:hover {
    color: #383838;
    text-shadow: 0 0 7px #838383;
}

.podcast-player__controls {
    gap: 0.5rem;
    display: flex;
    align-items: center;
    margin-top: 5px;
}

.podcast-player__seek-slider {
    -webkit-appearance: none;
    appearance: none;
    flex-grow: 1;
    height: 6px;
    background: #383838;
    border-radius: 3px;
    cursor: pointer;
    margin: 0 5px;
    order: 0;
}

.podcast-player__seek-slider::-webkit-slider-runnable-track {
    height: 6px;
    background: #383838;
    border-radius: 3px;
    border: none;
}

.podcast-player__seek-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 3px;
    height: 16px;
    background: #383838;
    border-radius: 2px;
    cursor: pointer;
    margin-top: -5px;
    transition: 0.2s;
}

.podcast-player__seek-slider::-webkit-slider-thumb:hover {
    height: 20px;
    background: #383838;
}

.podcast-player__seek-slider::-moz-range-track {
    height: 6px;
    background: #383838;
    border-radius: 3px;
    border: none;
}

.podcast-player__seek-slider::-moz-range-thumb {
    width: 3px;
    height: 16px;
    background: #383838;
    border-radius: 2px;
    border: none;
    cursor: pointer;
}

.podcast-player__seek-slider::-moz-range-progress {
    height: 6px;
    background: #383838;
    border-radius: 3px;
}

.podcast-player__button {
    color: #383838 !important;
}

i.fas.fa-volume-up {
    color: #383838 !important;
}

i.fas.fa-volume-mute {
    color: #383838 !important;
}

.podcast-player__title a:before {
    content: '';
    display: inline-block;
    width: 20px;
    height: 20px;
    background: url(https://i1.beon.fun/27/80/8027/14/1939914/WQhRmHY.gif) no-repeat center;
    background-size: contain;
    margin-right: 8px;
    vertical-align: middle;
}

a[onclick="openPodcastModal()"] img {
    display: none;
}

a[onclick="openPodcastModal()"] {
    display: inline-flex;
    align-items: center;
    gap: 5px;
}

a[onclick="openPodcastModal()"]::before {
    content: "";
    display: inline-block;
    width: 20px;
    height: 20px;
    background-image: url(https://i1.beon.fun/27/80/8027/14/1939914/WQhRmHY.gif);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
}

@media (max-width: 768px) {
.podcast-player__controls {
    flex-wrap: wrap;
}

.podcast-player__seek-slider {
    order: 1;
    width: 100% !important;
    flex-basis: 100%;
    margin-top: 5px;
}

.podcast-player__title a {
    font-size: 12px;
}

.podcast-player {
    max-width: 100%;
    padding: 0.8em;
}
}

